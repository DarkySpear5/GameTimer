{
  "name": "gamut",
  "version": "3.4.8",
  "description": "Gamut — a game playtime tracker",
  "main": "./out/main/index.js",
  "author": "DarkySpear5",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win --publish never",
    "package:dev": "cross-env GAMUT_CHANNEL=dev electron-vite build && electron-builder --win --config electron-builder.dev.yml --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "font-list": "^1.6.0",
    "i18next": "^26.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.55.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3"
  },
  "overrides": {
    "@noble/hashes": "^1.8.0"
  }
}
